APP_NAME="Portale B2B"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.brand.example.it

# Frontend SPA origin (per CORS + link nelle email / redirect Stripe)
SPA_URL=https://brand.example.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

# --- Pannello admin Filament ---
FILAMENT_PATH=access
FILAMENT_DOMAIN=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portale
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=portale_session
SESSION_DOMAIN=.brand.example.it

QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=brand.example.it,localhost:5173
# Nome del cookie/localStorage key lato SPA: "token" (Bearer personal access token)

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ordini@brand.example.it"
MAIL_FROM_NAME="${APP_NAME}"

# Backoffice CDM: riceve la notifica di ogni nuovo ordine dal portale
# (il commerciale lo carica manualmente su WinMino). Più indirizzi separati da virgola.
BACKOFFICE_EMAIL=

# --- Business config di default (sovrascrivibili da tabella app_config) ---
BIZ_VAT_RATE=22
BIZ_SHIPPING_COST=15.00
BIZ_MIN_ORDER_AMOUNT=0
BIZ_SCHEDULED_ORDER_DAYS=30

# --- Integrazioni (di norma gestite da pannello -> Configurazioni Sistema, cifrate in DB) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ERP (WinMino o equivalente del nuovo cliente)
ERP_DRIVER=null
ERP_BASE_URL=
ERP_API_KEY=
