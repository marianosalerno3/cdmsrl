# ------------------------------------------------------------------
#  infra/.env  — variabili per docker compose (copiare in infra/.env)
# ------------------------------------------------------------------

# Dominio pubblico. Caddy richiede automaticamente i certificati TLS per questi.
APP_DOMAIN=cdmsrl.example.it
API_DOMAIN=api.cdmsrl.example.it

# Email per Let's Encrypt (avvisi scadenza certificati)
ACME_EMAIL=devops@cdmsrl.example.it

# ------------------------------------------------------------------
#  Applicazione Laravel (portale-api)
# ------------------------------------------------------------------
APP_NAME="Portale B2B CDM"
APP_ENV=production
APP_DEBUG=false
# genera con:  docker compose run --rm api php artisan key:generate --show
APP_KEY=

# ------------------------------------------------------------------
#  Database (MariaDB)
# ------------------------------------------------------------------
DB_DATABASE=portale
DB_USERNAME=portale
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root

# ------------------------------------------------------------------
#  Mail (SMTP del cliente / provider)
# ------------------------------------------------------------------
MAIL_HOST=smtp.example.it
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ordini@cdmsrl.example.it

# ------------------------------------------------------------------
#  Immagine PHP: uid/gid dell'utente host proprietario di storage/
# ------------------------------------------------------------------
UID=1000
GID=1000
